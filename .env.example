# .env.example — ORTAM DEGISKENI SABLONU
#
# Bu dosya commit EDILIR ve yalnizca anahtar ISIMLERINI icerir; gercek degerleri
# ASLA buraya yazmayin. Kullanmak icin kopyalayin:
#
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
#
# Gercek .env dosyasi .gitignore tarafindan yok sayilir (bkz. .gitignore "Environments").
# Bir sir yanlislikla commit edilirse: anahtari HEMEN saglayicidan iptal edip yenileyin.
# Gecmisten silmek tek basina yetmez, sizmis sayilir.
#
# Proje kodu yazildikca kullanilan her degiskeni buraya da ekleyin.

# --- Uygulama ---
APP_ENV=development
LOG_LEVEL=info
PORT=8000

# --- AI / LLM saglayicilari (kullandiklarinizi birakin, digerlerini silin) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Veritabani ---
DATABASE_URL=

# --- Harici servisler ---
# ORNEK_API_BASE_URL=
# ORNEK_API_KEY=
